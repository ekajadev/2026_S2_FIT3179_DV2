{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart of the share of people who used a mobile device for card payments, by age, 2019 versus 2025. Under-30s rose from 18% to 69%; over-65s from 3% to 17%.",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Every age group took it up, but the gap grew",
    "subtitle": "Share of people who paid with a phone or watch, 2019 → 2025"
  },
  "data": {
    "url": "data/cps_mobile_device_use_by_age_2019_2025.csv"
  },
  "transform": [
    {
      "filter": "datum.Age !== 'All'"
    }
  ],
  "encoding": {
    "y": {
      "field": "Age",
      "type": "ordinal",
      "sort": [
        "18-29",
        "30-39",
        "40-49",
        "50-64",
        "65+"
      ],
      "axis": {
        "title": "Age group",
        "labelFontSize": 12,
        "labelPadding": 10,
        "grid": true,
        "gridColor": "#cfd6e0",
        "gridDash": [
          2,
          4
        ]
      }
    },
    "x": {
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          80
        ]
      },
      "axis": {
        "title": "People who paid with a phone or watch",
        "labelExpr": "datum.value + '%'",
        "values": [
          0,
          20,
          40,
          60,
          80
        ],
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#9aa6b8"
      },
      "encoding": {
        "x": {
          "field": "2019"
        },
        "x2": {
          "field": "2025"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "2019"
        },
        "tooltip": [
          {
            "field": "2022",
            "title": "2022 survey (%)",
            "format": ".0f"
          }
        ],
        "color": {
          "datum": "2019",
          "scale": {
            "domain": [
              "2019",
              "2025"
            ],
            "range": [
              "#9aa6b8",
              "#141a24"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "encoding": {
        "x": {
          "field": "2025"
        },
        "tooltip": [
          {
            "field": "2022",
            "title": "2022 survey (%)",
            "format": ".0f"
          }
        ],
        "color": {
          "datum": "2025"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 10,
        "color": "#5f6b7d"
      },
      "encoding": {
        "x": {
          "field": "2019"
        },
        "text": {
          "field": "2019",
          "format": ".0f"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 10,
        "color": "#141a24"
      },
      "encoding": {
        "x": {
          "field": "2025"
        },
        "text": {
          "field": "2025",
          "format": ".0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 24,
            "y": "65+",
            "t": "Gap widened from 15 to 51 points"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "color": "#3b4656",
        "font": "IBM Plex Sans, system-ui, sans-serif",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "nominal"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "IBM Plex Sans, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "IBM Plex Sans, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "IBM Plex Sans, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "heatmap": [
        "#ece6fb",
        "#d6cbf6",
        "#bca9ee",
        "#9f86e3",
        "#8366d6",
        "#6a48c4",
        "#512fa8"
      ],
      "diverging": [
        "#c2410c",
        "#e07a3a",
        "#f0b48a",
        "#f6dcc6",
        "#e4e9f0",
        "#bcd3f2",
        "#7fa9e4",
        "#3d7dd4",
        "#1b55a8"
      ]
    }
  }
}
