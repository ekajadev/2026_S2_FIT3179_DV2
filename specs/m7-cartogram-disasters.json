{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of Australia's 332 SA3 regions coloured by the share of face-to-face banking points that are Bank@Post outlets in June 2025. In most inner-city regions under a third of face-to-face points are post offices; across much of inland and northern Australia it is more than two thirds, and in some regions the post office is the only face-to-face banking left.",
  "usermeta": {
    "source": "APRA Authorised Deposit-taking Institutions Points of Presence, June 2025, Table 1 aggregated by SA3 (branches, Bank@Post, other face-to-face); ABS ASGS Edition 3 SA3 2021 boundaries",
    "url": "https://www.apra.gov.au/authorised-deposit-taking-institutions-points-of-presence",
    "method": "Bank@Post share = Bank@Post outlets ÷ (branches + Bank@Post + other face-to-face points) in each SA3. Regions with no face-to-face points are shown in grey. By ABS remoteness class the share is 41% in major cities, 47% inner regional, 53% outer regional, 57% remote and 69% very remote. Boundaries simplified to 1.5% in mapshaper. The colour ramp spans 30–70% (clamped) because most regions fall between 38% and 59%; a 0–100% ramp hid those differences.",
    "projection": "Conic equal-area with standard parallels 18°S and 36°S.",
    "zoom": {
      "min": 1,
      "max": 8,
      "note": "Zoom follows the Week 10 studio pattern exactly: a bound 'Zoom' slider and a 'Map centre' dropdown drive the projection's scale and translate through expressions. Pure Vega-Lite; nothing is added by JavaScript. projectedBounds are the d3-geo bounds at scale 150, used to fit the whole map at zoom 1; centre options are city coordinates projected the same way.",
      "projectedBounds": [
        -44.356,
        93.7,
        49.855,
        184.131
      ],
      "reason": "inner-city SA3 regions are a few kilometres across; 8× needed to see them"
    }
  },
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Further out, the post office is the bank",
    "subtitle": "Bank@Post share of face-to-face banking points by SA3 region, June 2025"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "scale": {
      "expr": "150 * min(width / 94.211, height / 90.431) * mapZoom"
    },
    "translate": {
      "expr": "[width / 2 - mapCentre[0] * min(width / 94.211, height / 90.431) * mapZoom, height / 2 - mapCentre[1] * min(width / 94.211, height / 90.431) * mapZoom]"
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/sa3_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.SA3_NAME21",
          "from": {
            "data": {
              "url": "data/apra_sa3_2017_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "f2f_bankpost_share_pct": "number",
                  "bankpost_2025": "number",
                  "branches_2025": "number",
                  "branches_2017": "number",
                  "other_f2f_2025": "number",
                  "f2f_points_2025": "number"
                }
              }
            },
            "key": "sa3",
            "fields": [
              "state",
              "f2f_bankpost_share_pct",
              "bankpost_2025",
              "branches_2025",
              "branches_2017",
              "other_f2f_2025",
              "f2f_points_2025"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.4,
        "clip": true
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.f2f_bankpost_share_pct)",
            "value": "#d5dce6"
          },
          "field": "f2f_bankpost_share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              70
            ],
            "clamp": true,
            "range": [
              "#fde8d2",
              "#f9cfa3",
              "#f3b26f",
              "#ea9340",
              "#d9741b",
              "#b85c0f",
              "#8f4508"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 220,
            "title": "Bank@Post share",
            "labelExpr": "datum.value === 30 ? '30% or less' : datum.value === 70 ? '70% or more' : datum.value + '%'",
            "values": [
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.SA3_NAME21",
            "title": "Region (SA3)"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "f2f_bankpost_share_pct",
            "title": "Bank@Post share (%)"
          },
          {
            "field": "bankpost_2025",
            "title": "Bank@Post outlets"
          },
          {
            "field": "branches_2025",
            "title": "Branches 2025"
          },
          {
            "field": "branches_2017",
            "title": "Branches 2017"
          },
          {
            "field": "f2f_points_2025",
            "title": "All face-to-face points"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 110.5,
            "lat": -24,
            "t": "Share of face-to-face banking points"
          },
          {
            "lon": 110.5,
            "lat": -25.8,
            "t": "that are post offices, by remoteness:"
          },
          {
            "lon": 110.5,
            "lat": -28.4,
            "t": "Major cities 41%"
          },
          {
            "lon": 110.5,
            "lat": -30.2,
            "t": "Inner regional 47%"
          },
          {
            "lon": 110.5,
            "lat": -32,
            "t": "Outer regional 53%"
          },
          {
            "lon": 110.5,
            "lat": -33.8,
            "t": "Remote 57%"
          },
          {
            "lon": 110.5,
            "lat": -35.6,
            "t": "Very remote 69%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 10,
        "color": "#3b4656",
        "font": "Space Grotesk, system-ui, sans-serif",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "params": [
    {
      "name": "mapZoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 8,
        "step": 0.1,
        "name": "Zoom: "
      }
    },
    {
      "name": "mapCentre",
      "value": [
        2.749,
        138.916
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            2.749,
            138.916
          ],
          [
            41.371,
            160.285
          ],
          [
            26.924,
            168.853
          ],
          [
            48.03,
            144.205
          ],
          [
            -35.436,
            154.346
          ],
          [
            14.117,
            160.321
          ],
          [
            30.265,
            182.346
          ],
          [
            -3.019,
            100.876
          ]
        ],
        "labels": [
          "Whole country",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Hobart",
          "Darwin"
        ],
        "name": "Map centre: "
      }
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "Space Grotesk, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "Space Grotesk, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "Space Grotesk, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "Space Grotesk, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "Space Grotesk, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Mono, monospace",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
