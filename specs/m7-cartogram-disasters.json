{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of Australia's 332 SA3 regions coloured by the share of face-to-face banking points that are Bank@Post outlets in June 2025. In most inner-city regions under a third of face-to-face points are post offices; across much of inland and northern Australia it is more than two thirds, and in some regions the post office is the only face-to-face banking left.",
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "The further from a city, the more banking happens at the post office",
    "subtitle": "Bank@Post share of face-to-face banking points by council-sized region, June 2025"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "scale": {
      "expr": "150 * min(width / 94.211, height / 90.431)"
    },
    "translate": {
      "expr": "[width / 2 - 2.749 * min(width / 94.211, height / 90.431), height / 2 - 138.916 * min(width / 94.211, height / 90.431)]"
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/sa3_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.SA3_NAME21",
          "from": {
            "data": {
              "url": "data/apra_sa3_2017_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "f2f_bankpost_share_pct": "number",
                  "bankpost_2025": "number",
                  "branches_2025": "number",
                  "branches_2017": "number",
                  "other_f2f_2025": "number",
                  "f2f_points_2025": "number"
                }
              }
            },
            "key": "sa3",
            "fields": [
              "state",
              "f2f_bankpost_share_pct",
              "bankpost_2025",
              "branches_2025",
              "branches_2017",
              "other_f2f_2025",
              "f2f_points_2025"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.4,
        "clip": true
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.f2f_bankpost_share_pct)",
            "value": "#d5dce6"
          },
          "field": "f2f_bankpost_share_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              40,
              50,
              60,
              70
            ],
            "range": [
              "#fde8d2",
              "#f6c08a",
              "#ea9340",
              "#c4620f",
              "#8f4508"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": "Bank@Post share",
            "symbolType": "square",
            "symbolSize": 120,
            "gradientLength": 200,
            "labelExpr": "isFinite(datum.value) ? datum.value + '%' : ''"
          }
        },
        "tooltip": [
          {
            "field": "properties.SA3_NAME21",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "f2f_bankpost_share_pct",
            "title": "Bank@Post share (%)"
          },
          {
            "field": "bankpost_2025",
            "title": "Bank@Post outlets"
          },
          {
            "field": "branches_2025",
            "title": "Branches 2025"
          },
          {
            "field": "branches_2017",
            "title": "Branches 2017"
          },
          {
            "field": "f2f_points_2025",
            "title": "All face-to-face points"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "IBM Plex Sans, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "IBM Plex Sans, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "IBM Plex Sans, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "heatmap": [
        "#ece6fb",
        "#d6cbf6",
        "#bca9ee",
        "#9f86e3",
        "#8366d6",
        "#6a48c4",
        "#512fa8"
      ],
      "diverging": [
        "#c2410c",
        "#e07a3a",
        "#f0b48a",
        "#f6dcc6",
        "#e4e9f0",
        "#bcd3f2",
        "#7fa9e4",
        "#3d7dd4",
        "#1b55a8"
      ]
    }
  }
}
