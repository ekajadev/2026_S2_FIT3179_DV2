{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart ranking eight spending sectors by the share of payments made online in 2019, 2022 and 2025. Bills and holidays sit at the top (82% and 81% online in 2025); petrol and supermarkets stay at the bottom (1% and 5%). Holidays jumped from third to second after dropping in 2022.",
  "usermeta": {
    "source": "Kim & Reschke, Consumer Payment Behaviour in Australia, RBA Bulletin, 28 May 2026, Graph 9",
    "url": "https://www.rba.gov.au/publications/bulletin/2026/may/consumer-payment-behaviour-in-australia.html",
    "method": "Online share of payments by number within each sector. Rank 1 is the most-online sector in that wave."
  },
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Bills and holidays moved online. Petrol never did.",
    "subtitle": [
      "Sectors ranked by share of payments made online, 2019–2025.",
      "Grey: the other five sectors."
    ]
  },
  "data": {
    "url": "data/cps_online_share_by_sector_2019_2025.csv"
  },
  "transform": [
    {
      "fold": [
        "2019",
        "2022",
        "2025"
      ],
      "as": [
        "year",
        "share"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "share",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": "Survey year",
        "labelFontSize": 12,
        "labelPadding": 8
      },
      "scale": {
        "padding": 1.5
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "axis": {
        "title": "Rank by online share (1 = most online)",
        "labelExpr": "'#' + datum.value",
        "grid": false,
        "labelPadding": 10
      }
    },
    "color": {
      "field": "Sector",
      "type": "nominal",
      "scale": {
        "domain": [
          "Bills",
          "Holiday",
          "Petrol",
          "Leisure",
          "Services",
          "Goods",
          "Food retail",
          "Supermarket"
        ],
        "range": [
          "#1f6fd6",
          "#d64545",
          "#d96a10",
          "#b6bfcc",
          "#b6bfcc",
          "#b6bfcc",
          "#b6bfcc",
          "#b6bfcc"
        ]
      },
      "legend": {
        "orient": "top",
        "title": null,
        "values": [
          "Bills",
          "Holiday",
          "Petrol"
        ],
        "labelExpr": "datum.label"
      }
    },
    "detail": {
      "field": "Sector"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 330,
        "stroke": "#f8fafc",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Sector"
          },
          {
            "field": "year",
            "title": "Survey"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Paid online (%)",
            "format": ".0f"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#ffffff",
        "font": "Space Grotesk, system-ui, sans-serif",
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#ffffff"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2025'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 11,
        "color": "#141a24"
      },
      "encoding": {
        "text": {
          "field": "Sector"
        },
        "color": {
          "value": "#141a24"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2019'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "fontSize": 10,
        "color": "#5f6b7d"
      },
      "encoding": {
        "text": {
          "field": "Sector"
        },
        "color": {
          "value": "#5f6b7d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2025",
            "rank": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -18,
        "fontSize": 10.5,
        "font": "Space Grotesk, system-ui, sans-serif",
        "color": "#d64545",
        "fontWeight": 600,
        "dx": 8
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "ordinal"
        },
        "text": {
          "value": "Holidays: 51% → 81% online, 2022 to 2025"
        },
        "color": {
          "value": "#d64545"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "Space Grotesk, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "Space Grotesk, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "Space Grotesk, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "Space Grotesk, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "Space Grotesk, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Mono, monospace",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "heatmap": [
        "#ece6fb",
        "#d6cbf6",
        "#bca9ee",
        "#9f86e3",
        "#8366d6",
        "#6a48c4",
        "#512fa8"
      ],
      "diverging": [
        "#c2410c",
        "#e07a3a",
        "#f0b48a",
        "#f6dcc6",
        "#e4e9f0",
        "#bcd3f2",
        "#7fa9e4",
        "#3d7dd4",
        "#1b55a8"
      ]
    }
  }
}
