{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile cartogram of Australia's eight states and territories, each a same-sized square placed roughly in its geographic position, coloured by the number of places to get cash (bank branches, Bank@Post outlets and bank-operated ATMs) per 10,000 residents in June 2025. The ACT has 8.9 per 10,000 and South Australia 2.6.",
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Places to get cash are thinnest in the most populous states",
    "subtitle": "Bank branches, Bank@Post and bank ATMs per 10,000 residents, June 2025"
  },
  "data": {
    "url": "data/apra_state_access_2025.csv"
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "values": [
            {
              "state": "WA",
              "col": 0,
              "row": 1
            },
            {
              "state": "NT",
              "col": 1,
              "row": 0
            },
            {
              "state": "SA",
              "col": 1,
              "row": 1
            },
            {
              "state": "QLD",
              "col": 2,
              "row": 0
            },
            {
              "state": "NSW",
              "col": 2,
              "row": 1
            },
            {
              "state": "ACT",
              "col": 3,
              "row": 1
            },
            {
              "state": "VIC",
              "col": 2,
              "row": 2
            },
            {
              "state": "TAS",
              "col": 2,
              "row": 3
            }
          ]
        },
        "key": "state",
        "fields": [
          "col",
          "row"
        ]
      }
    },
    {
      "calculate": "format(datum.cash_points_per_10k, '.1f')",
      "as": "lbl"
    },
    {
      "calculate": "{\"WA\": \"Western Australia\", \"NT\": \"Northern Territory\", \"SA\": \"South Australia\", \"QLD\": \"Queensland\", \"NSW\": \"New South Wales\", \"VIC\": \"Victoria\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital Territory\"}[datum.state]",
      "as": "name"
    },
    {
      "calculate": "{\"WA\": \"Western|Australia\", \"NT\": \"Northern|Territory\", \"SA\": \"South|Australia\", \"QLD\": \"Queensland\", \"NSW\": \"New South|Wales\", \"VIC\": \"Victoria\", \"TAS\": \"Tasmania\", \"ACT\": \"Australian Capital|Territory\"}[datum.state]",
      "as": "nameLines"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.08,
        "paddingOuter": 0.05
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.08,
        "paddingOuter": 0.05
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "stroke": "#f8fafc",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "cash_points_per_10k",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              3,
              5,
              8
            ],
            "range": [
              "#fde8d2",
              "#f3b26f",
              "#d9741b",
              "#8f4508"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Cash points per 10,000 people",
            "symbolType": "square",
            "symbolSize": 120,
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "branches",
            "title": "Branches 2025"
          },
          {
            "field": "branches_2017",
            "title": "Branches 2017"
          },
          {
            "field": "branch_change_pct",
            "title": "Branch change (%)",
            "format": "+.0f"
          },
          {
            "field": "bankpost",
            "title": "Bank@Post outlets"
          },
          {
            "field": "atms",
            "title": "Bank ATMs"
          },
          {
            "field": "population",
            "title": "Population",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "fontWeight": 500,
        "lineHeight": 14,
        "font": "IBM Plex Sans, system-ui, sans-serif",
        "baseline": "middle",
        "dy": -8
      },
      "encoding": {
        "text": {
          "field": "tileLabel"
        },
        "color": {
          "condition": {
            "test": "datum.cash_points_per_10k >= 8",
            "value": "#ffffff"
          },
          "value": "#141a24"
        }
      },
      "transform": [
        {
          "calculate": "split(datum.nameLines + '|' + format(datum.cash_points_per_10k, '.1f') + (datum.state === 'ACT' ? ' (most)' : datum.state === 'SA' ? ' (fewest)' : ''), '|')",
          "as": "tileLabel"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "col": 0,
            "row": 3,
            "t": [
              "Australian Capital Territory:",
              "3.4× the cash points",
              "per person of South Australia"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 10,
        "color": "#3b4656",
        "font": "IBM Plex Sans, system-ui, sans-serif",
        "dx": 0,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "IBM Plex Sans, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "IBM Plex Sans, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "IBM Plex Sans, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "heatmap": [
        "#ece6fb",
        "#d6cbf6",
        "#bca9ee",
        "#9f86e3",
        "#8366d6",
        "#6a48c4",
        "#512fa8"
      ],
      "diverging": [
        "#c2410c",
        "#e07a3a",
        "#f0b48a",
        "#f6dcc6",
        "#e4e9f0",
        "#bcd3f2",
        "#7fa9e4",
        "#3d7dd4",
        "#1b55a8"
      ]
    }
  }
}
