{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Coordinated views: a proportional symbol map of bank branches by SA3 region and a line chart of total branches per year, June 2017 to June 2025. Dragging across years on the line chart sets the period; the map shows each region's branches at the end of that period (circle area) and the percentage change over it (colour). Over the full period Australia went from 5,673 to 3,191 matched branches, a fall of 44%.",
  "title": {
    "text": "Australia closed 44% of its bank branches in eight years",
    "subtitle": [
      "Drag across years on the line chart to compare any two Junes.",
      "Circle size is branches at the end of the period; colour is the change over it."
    ]
  },
  "vconcat": [
    {
      "width": 670,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0,
          0
        ],
        "scale": {
          "expr": "150 * min(670 / 94.211, 440 / 90.009)"
        },
        "translate": {
          "expr": "[670 / 2 - 2.751 * min(670 / 94.211, 440 / 90.009), 440 / 2 - 139.139 * min(670 / 94.211, 440 / 90.009)]"
        },
        "clipExtent": [
          [
            0,
            0
          ],
          [
            670,
            440
          ]
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/geo/ste_2021.topo.json",
            "format": {
              "type": "topojson",
              "feature": "STE_2021_AUST_GDA2020"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#dfe5ed",
            "stroke": "#ffffff",
            "strokeWidth": 0.8,
            "clip": true,
            "aria": false
          }
        },
        {
          "data": {
            "url": "data/apra_sa3_by_year_2017_2025.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "branches": "number",
                "atms": "number",
                "bankpost": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": {
                "param": "yearBrush",
                "empty": true
              }
            },
            {
              "aggregate": [
                {
                  "op": "argmin",
                  "field": "year",
                  "as": "first"
                },
                {
                  "op": "argmax",
                  "field": "year",
                  "as": "last"
                }
              ],
              "groupby": [
                "sa3",
                "state",
                "lon",
                "lat"
              ]
            },
            {
              "calculate": "datum.first.branches",
              "as": "start"
            },
            {
              "calculate": "datum.last.branches",
              "as": "end"
            },
            {
              "calculate": "datum.first.year",
              "as": "y0"
            },
            {
              "calculate": "datum.last.year",
              "as": "y1"
            },
            {
              "calculate": "datum.start > 0 ? (datum.end - datum.start) / datum.start * 100 : null",
              "as": "change"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "circle",
                "opacity": 0.7,
                "stroke": "#ffffff",
                "strokeWidth": 0.8,
                "clip": true
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat",
                  "type": "quantitative"
                },
                "size": {
                  "field": "end",
                  "type": "quantitative",
                  "scale": {
                    "type": "sqrt",
                    "domain": [
                      1,
                      120
                    ],
                    "range": [
                      6,
                      700
                    ]
                  },
                  "legend": {
                    "orient": "bottom-left",
                    "title": "Branches at end of period",
                    "values": [
                      5,
                      25,
                      100
                    ],
                    "symbolFillColor": "#9aa6b8",
                    "symbolStrokeColor": "#ffffff",
                    "direction": "horizontal",
                    "columns": 3
                  }
                },
                "color": {
                  "field": "change",
                  "type": "quantitative",
                  "scale": {
                    "domain": [
                      -60,
                      60
                    ],
                    "clamp": true,
                    "range": [
                      "#c2410c",
                      "#e07a3a",
                      "#f0b48a",
                      "#f6dcc6",
                      "#e4e9f0",
                      "#bcd3f2",
                      "#7fa9e4",
                      "#3d7dd4",
                      "#1b55a8"
                    ]
                  },
                  "legend": {
                    "orient": "bottom-right",
                    "direction": "horizontal",
                    "gradientLength": 160,
                    "title": "Change over period",
                    "labelExpr": "datum.value + '%'",
                    "values": [
                      -60,
                      0,
                      60
                    ]
                  }
                },
                "tooltip": [
                  {
                    "field": "sa3",
                    "title": "Region"
                  },
                  {
                    "field": "state",
                    "title": "State"
                  },
                  {
                    "field": "start",
                    "title": "Branches then"
                  },
                  {
                    "field": "end",
                    "title": "Branches now"
                  },
                  {
                    "field": "change",
                    "title": "Change (%)",
                    "format": "+.0f"
                  }
                ],
                "order": {
                  "field": "end",
                  "sort": "descending"
                }
              },
              "transform": [
                {
                  "filter": "datum.end > 0"
                }
              ]
            },
            {
              "transform": [
                {
                  "filter": "datum.end > 0"
                },
                {
                  "filter": "indexof(['Sydney Inner City','Melbourne City','Brisbane Inner','Newcastle'], datum.sa3) >= 0"
                },
                {
                  "calculate": "replace(replace(datum.sa3, ' Inner City', ''), ' City', '') + ' ' + datum.start + ' → ' + datum.end",
                  "as": "lbl"
                }
              ],
              "mark": {
                "type": "text",
                "align": {
                  "expr": "datum.sa3 === 'Brisbane Inner' ? 'right' : 'left'"
                },
                "dx": {
                  "expr": "datum.sa3 === 'Brisbane Inner' ? -16 : 16"
                },
                "fontSize": 10.5,
                "font": "IBM Plex Sans, system-ui, sans-serif",
                "color": "#141a24",
                "clip": true
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "lbl"
                }
              }
            },
            {
              "transform": [
                {
                  "aggregate": [
                    {
                      "op": "sum",
                      "field": "start",
                      "as": "s"
                    },
                    {
                      "op": "sum",
                      "field": "end",
                      "as": "e"
                    },
                    {
                      "op": "min",
                      "field": "y0",
                      "as": "a"
                    },
                    {
                      "op": "max",
                      "field": "y1",
                      "as": "z"
                    }
                  ]
                },
                {
                  "calculate": "'June ' + datum.a + ' → June ' + datum.z + ': ' + format(datum.s, ',') + ' → ' + format(datum.e, ',') + ' branches (' + format((datum.e / datum.s - 1) * 100, '+.0f') + '%)'",
                  "as": "lbl"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "x": 0,
                "y": 12,
                "fontSize": 13,
                "fontWeight": 600,
                "font": "IBM Plex Sans, system-ui, sans-serif",
                "color": "#8f4508"
              },
              "encoding": {
                "text": {
                  "field": "lbl"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "width": 670,
      "height": 90,
      "data": {
        "url": "data/apra_sa3_by_year_2017_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "branches": "number",
            "atms": "number",
            "bankpost": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "branches",
              "as": "total"
            }
          ],
          "groupby": [
            "year"
          ]
        }
      ],
      "title": {
        "text": "Drag across years here to choose the period (click outside to clear)",
        "fontSize": 12,
        "fontWeight": 500,
        "anchor": "start"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2017,
              2025
            ]
          },
          "axis": {
            "title": "Year (June)",
            "format": "d",
            "values": [
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023,
              2024,
              2025
            ],
            "grid": false
          }
        },
        "y": {
          "field": "total",
          "type": "quantitative",
          "scale": {
            "domain": [
              2500,
              6000
            ]
          },
          "axis": {
            "title": "Branches",
            "values": [
              3000,
              4000,
              5000,
              6000
            ],
            "labelExpr": "format(datum.value, ',')"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#d96a10",
            "strokeWidth": 2
          },
          "params": [
            {
              "name": "yearBrush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ],
                "mark": {
                  "fill": "#1f6fd6",
                  "fillOpacity": 0.12,
                  "stroke": "#1f6fd6",
                  "aria": false
                }
              }
            }
          ]
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "color": "#d96a10",
            "size": 40
          },
          "encoding": {
            "tooltip": [
              {
                "field": "total",
                "title": "Branches",
                "format": ","
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "background": "transparent",
    "padding": 0,
    "font": "IBM Plex Sans, system-ui, sans-serif",
    "view": {
      "stroke": null,
      "continuousWidth": 480,
      "continuousHeight": 260
    },
    "title": {
      "font": "Space Grotesk, system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": 500,
      "color": "#141a24",
      "anchor": "start",
      "lineHeight": 23,
      "offset": 16,
      "subtitleFont": "IBM Plex Sans, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#3b4656",
      "subtitlePadding": 8,
      "subtitleLineHeight": 17
    },
    "axis": {
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 10,
      "labelColor": "#5f6b7d",
      "labelPadding": 10,
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#3b4656",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "axisY": {
      "grid": true,
      "gridColor": "#cfd6e0",
      "gridWidth": 1,
      "gridDash": [
        2,
        4
      ]
    },
    "axisX": {
      "grid": false,
      "labelAngle": 0
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "IBM Plex Mono, monospace",
      "labelFontSize": 11,
      "labelColor": "#3b4656",
      "symbolType": "circle",
      "symbolSize": 40,
      "columnPadding": 20,
      "rowPadding": 8,
      "offset": 16
    },
    "header": {
      "labelFont": "IBM Plex Sans, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#141a24",
      "titleFont": "IBM Plex Sans, system-ui, sans-serif",
      "titleColor": "#3b4656"
    },
    "line": {
      "strokeWidth": 2.5,
      "strokeCap": "round",
      "strokeJoin": "round"
    },
    "point": {
      "size": 50,
      "filled": true
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "area": {
      "opacity": 0.9
    },
    "arc": {
      "stroke": "#f8fafc",
      "strokeWidth": 2
    },
    "rule": {
      "color": "#8a97ab",
      "strokeWidth": 1
    },
    "geoshape": {
      "stroke": "#f8fafc",
      "strokeWidth": 0.5
    },
    "text": {
      "font": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": 11,
      "fontWeight": 400,
      "color": "#3b4656"
    },
    "range": {
      "category": [
        "#d96a10",
        "#1f6fd6",
        "#1a9e5c",
        "#6d4bd6",
        "#d64545",
        "#d6409f",
        "#0e9aa7",
        "#7d8898"
      ],
      "ordinal": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "ramp": [
        "#fde8d2",
        "#f9cfa3",
        "#f3b26f",
        "#ea9340",
        "#d9741b",
        "#b85c0f",
        "#8f4508"
      ],
      "heatmap": [
        "#ece6fb",
        "#d6cbf6",
        "#bca9ee",
        "#9f86e3",
        "#8366d6",
        "#6a48c4",
        "#512fa8"
      ],
      "diverging": [
        "#c2410c",
        "#e07a3a",
        "#f0b48a",
        "#f6dcc6",
        "#e4e9f0",
        "#bcd3f2",
        "#7fa9e4",
        "#3d7dd4",
        "#1b55a8"
      ]
    }
  }
}
